FROM debian:bullseye-slim

ENV GH_RUNNER_VERSION=2.322.0

# Install dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    tar \
    wget \
    libicu67 \
    libkrb5-3 \
    zlib1g \
    libc6 \
    libgcc1 \
    libssl1.1 \
    libstdc++6 \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Install .NET Runtime
RUN wget https://dot.net/v1/dotnet-install.sh -O dotnet-install.sh \
    && chmod +x ./dotnet-install.sh \
    && ./dotnet-install.sh --runtime dotnet --channel 6.0 --install-dir /usr/share/dotnet \
    && ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet \
    && rm dotnet-install.sh

# Set the PATH to include .NET
ENV PATH="/usr/share/dotnet:${PATH}"

# Set up the runner
WORKDIR /runner

# Download and extract the runner
RUN curl -o actions-runner-linux-x64-${GH_RUNNER_VERSION}.tar.gz -L https://github.com/actions/runner/releases/download/v${GH_RUNNER_VERSION}/actions-runner-linux-x64-${GH_RUNNER_VERSION}.tar.gz \
    && tar xzf actions-runner-linux-x64-${GH_RUNNER_VERSION}.tar.gz \
    && rm actions-runner-linux-x64-${GH_RUNNER_VERSION}.tar.gz

# Create non-root user
RUN useradd -m -d /runner runner && chown -R runner:runner /runner

USER runner

# Copy entrypoint script
COPY docker/entrypoint.sh /runner/entrypoint.sh

ENTRYPOINT ["/runner/entrypoint.sh"]
